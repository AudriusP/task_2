              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Response has an array with at least 1 item\", function () {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData[0]).to.have.property(\"items\");",
                      "    pm.expect(jsonData[0].items).to.be.an('array');",
                      "    pm.expect(jsonData[0].items.length).to.be.above(0);",
                      "    pm.environment.set(\"item_id\", jsonData[0].items[0]);",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{user_token}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/user/items?limit=1",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "user",
                    "items"
                  ],
                  "query": [
                    {
                      "key": "limit",
                      "value": "1"
                    }
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Get user item",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const files_schema = {",
                      "    type: \"array\",",
                      "    items: {",
                      "        type: \"object\",",
                      "        properties: {",
                      "            id: {",
                      "                type: \"string\"",
                      "            },",
                      "            name: {",
                      "                type: \"string\"",
                      "            },",
                      "            size: {",
                      "                type: \"number\"",
                      "            },",
                      "            content_path: {",
                      "                type: \"string\"",
                      "            },",
                      "        },",
                      "        required: [\"id\", \"name\", \"size\", \"content_path\"]",
                      "    }",
                      "};",
                      "pm.environment.set(\"files_schema\", JSON.stringify(files_schema));",
                      "const fields_schema = {",
                      "    type: \"array\",",
                      "    items: {",
                      "        type: \"object\",",
                      "        properties: {",
                      "            id: {",
                      "                type: \"string\"",
                      "            },",
                      "            label: {",
                      "                type: \"string\"",
                      "            },",
                      "            type: {",
                      "                type: \"string\"",
                      "            },",
                      "            value: {",
                      "                type: \"string\"",
                      "            },",
                      "        },",
                      "        required: [\"id\", \"label\", \"type\", \"value\"]",
                      "    }",
                      "};",
                      "pm.environment.set(\"fields_schema\", JSON.stringify(fields_schema));",
                      "const shares_schema = {",
                      "    type: \"array\",",
                      "    items: {",
                      "        type: \"object\",",
                      "        properties: {",
                      "            user_uuid: {",
                      "                type: \"string\"",
                      "            },",
                      "            email: {",
                      "                type: \"string\",",
                      "                format: \"email\"",
                      "            },",
                      "            status: {",
                      "                type: \"string\"",
                      "            },",
                      "            updated_at: {",
                      "                type: \"string\",",
                      "                format: \"date-time\"",
                      "            },",
                      "        },",
                      "        required: [\"user_uuid\", \"email\", \"status\", \"updated_at\"]",
                      "    }",
                      "};",
                      "",
                      "pm.test(\"Status code is 200\", function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test(\"Response has item data with all correct fields\", function () {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData).to.be.a(\"array\");",
                      "",
                      "    pm.expect(jsonData[0]).to.have.property(\"id\");",
                      "    pm.expect(jsonData[0].id).to.be.a(\"string\");",
                      "    pm.expect(jsonData[0].id.length).to.be.above(0);",
                      "",
                      "    pm.expect(jsonData[0]).to.have.property(\"title\");",
                      "    pm.expect(jsonData[0].title).to.be.a(\"string\");",
                      "    pm.expect(jsonData[0].id.length).to.be.above(0);",
                      "",
                      "    pm.expect(jsonData[0]).to.have.property(\"tags\");",
                      "    pm.expect(jsonData[0].tags).to.be.a(\"array\");",
                      "",
                      "    pm.expect(jsonData[0]).to.have.property(\"files\");",
                      "    pm.expect(jsonData[0].files).to.be.a(\"array\");",
                      "    pm.expect(jsonData[0].files).to.have.jsonSchema(files_schema);",
                      "",
                      "    pm.expect(jsonData[0]).to.have.property(\"fields\");",
                      "    pm.expect(jsonData[0].fields).to.be.a(\"array\");",
                      "    pm.expect(jsonData[0].fields).to.have.jsonSchema(fields_schema);",
                      "",
                      "    pm.expect(jsonData[0]).to.have.property(\"shares\");",
                      "    pm.expect(jsonData[0].shares).to.be.a(\"array\");",
                      "    pm.expect(jsonData[0].shares).to.have.jsonSchema(shares_schema);",
                      "",
                      "    pm.expect(jsonData[0]).to.have.property(\"created_at\");",
                      "    pm.expect(jsonData[0].created_at).to.have.jsonSchema({ type: \"string\", format: \"date-time\" });",
                      "",
                      "    pm.expect(jsonData[0]).to.have.property(\"updated_at\");",
                      "    pm.expect(jsonData[0].updated_at).to.have.jsonSchema({ type: \"string\", format: \"date-time\" });",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
